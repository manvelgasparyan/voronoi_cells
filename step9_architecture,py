# 2. STANDARD ARCHITECTURE (from previous steps)
# ============================================================================

class StandardCNN(nn.Module):
    """Standard architecture used in Steps 1-8"""
    def __init__(self, input_channels=3, feature_dim=2, num_classes=10):
        super(StandardCNN, self).__init__()
        
        self.feature_extractor = nn.Sequential(
            nn.Conv2d(input_channels, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(),
            nn.Conv2d(64, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(),
            nn.MaxPool2d(2),
            
            nn.Conv2d(64, 128, kernel_size=3, padding=1),
            nn.BatchNorm2d(128),
            nn.ReLU(),
            nn.Conv2d(128, 128, kernel_size=3, padding=1),
            nn.BatchNorm2d(128),
            nn.ReLU(),
            nn.MaxPool2d(2),
            
            nn.Conv2d(128, 256, kernel_size=3, padding=1),
            nn.BatchNorm2d(256),
            nn.ReLU(),
            nn.Conv2d(256, 256, kernel_size=3, padding=1),
            nn.BatchNorm2d(256),
            nn.ReLU(),
            nn.AdaptiveAvgPool2d((4, 4))
        )
        
        self.flatten = nn.Flatten()
        self.fc1 = nn.Linear(256 * 4 * 4, 512)
        self.bn1 = nn.BatchNorm1d(512)
        self.relu = nn.ReLU()
        self.dropout = nn.Dropout(0.3)
        self.fc2 = nn.Linear(512, 256)
        self.bn2 = nn.BatchNorm1d(256)
        self.feature_layer = nn.Linear(256, feature_dim)
        
        self.register_buffer('prototypes', torch.zeros(num_classes, feature_dim))
        self.classifier = nn.Linear(feature_dim, num_classes)
        
    def forward(self, x, return_features=False):
        feats = self.feature_extractor(x)
        feats = self.flatten(feats)
        feats = self.fc1(feats)
        feats = self.bn1(feats)
        feats = self.relu(feats)
        feats = self.dropout(feats)
        feats = self.fc2(feats)
        feats = self.bn2(feats)
        feats = self.relu(feats)
        features = self.feature_layer(feats)
        logits = self.classifier(features)
        
        if return_features:
            return logits, features
        return logits


# ============================================================================
# 3. VORONOI UTILITIES
# ============================================================================

def assign_voronoi_cells(features, prototypes, device=None):
    if device is None:
        device = prototypes.device
    features = features.to(device)
    prototypes = prototypes.to(device)
    distances = torch.cdist(features, prototypes)
    cell_assignments = torch.argmin(distances, dim=1)
    return cell_assignments


def compute_cell_purity(features, labels, prototypes):
    device = prototypes.device
    cell_assignments = assign_voronoi_cells(features, prototypes, device=device)
    cell_assignments = cell_assignments.cpu()
    labels = labels.cpu()
    
    purity_per_cell = {}
    for i in range(len(prototypes)):
        mask = (cell_assignments == i)
        if mask.sum() > 0:
            labels_in_cell = labels[mask]
            correct_count = (labels_in_cell == i).sum().item()
            purity = correct_count / mask.sum().item()
            purity_per_cell[i] = purity
        else:
            purity_per_cell[i] = 0.0
    
    overall_purity = np.mean(list(purity_per_cell.values())) if purity_per_cell else 0
    return overall_purity, purity_per_cell


def compute_collision_mass(features, labels, prototypes):
    device = prototypes.device
    features = features.to(device)
    prototypes = prototypes.to(device)
    labels = labels.to(device)
    
    cell_assignments = assign_voronoi_cells(features, prototypes, device=device)
    
    k = len(prototypes)
    collision_per_cell = {}
    
    for i in range(k):
        mask = (cell_assignments == i)
        if mask.sum() == 0:
            collision_per_cell[i] = 0.0
            continue
        
        labels_in_cell = labels[mask]
        correct_count = (labels_in_cell == i).sum().item()
        total_in_cell = mask.sum().item()
        collision = 1 - (correct_count / total_in_cell)
        collision_per_cell[i] = collision
    
    overall_collision = np.mean(list(collision_per_cell.values())) if collision_per_cell else 0
    return overall_collision, collision_per_cell


def compute_prototypes_from_features(features, labels, num_classes):
    device = features.device
    prototypes = torch.zeros(num_classes, features.shape[1], device=device)
    counts = torch.zeros(num_classes, device=device)
    
    for c in range(num_classes):
        mask = (labels == c)
        if mask.sum() > 0:
            prototypes[c] = features[mask].mean(dim=0)
            counts[c] = mask.sum().float()
    
    return prototypes, counts


# ============================================================================
# 4. TRAINING FUNCTION
# ============================================================================

def train_epoch(model, dataloader, optimizer, criterion, device):
    model.train()
    total_loss = 0
    correct = 0
    total = 0
    
    for images, labels in tqdm(dataloader, desc="Training", leave=False):
        images, labels = images.to(device), labels.to(device)
        
        optimizer.zero_grad()
        logits = model(images)
        loss = criterion(logits, labels)
        loss.backward()
        optimizer.step()
        
        total_loss += loss.item()
        _, predicted = torch.max(logits, 1)
        total += labels.size(0)
        correct += (predicted == labels).sum().item()
    
    return total_loss / len(dataloader), correct / total


@torch.no_grad()
def evaluate(model, dataloader, device, compute_features=False):
    model.eval()
    correct = 0
    total = 0
    all_features = []
    all_labels = []
    
    for images, labels in tqdm(dataloader, desc="Evaluating", leave=False):
        images, labels = images.to(device), labels.to(device)
        logits = model(images)
        
        if compute_features:
            _, features = model.forward(images, return_features=True)
            all_features.append(features.cpu())
            all_labels.append(labels.cpu())
        
        _, predicted = torch.max(logits, 1)
        total += labels.size(0)
        correct += (predicted == labels).sum().item()
    
    accuracy = correct / total
    
    if compute_features:
        all_features = torch.cat(all_features, dim=0)
        all_labels = torch.cat(all_labels, dim=0)
        return accuracy, all_features, all_labels
    
    return accuracy


# ============================================================================
# 5. SINGLE ARCHITECTURE EXPERIMENT
# ============================================================================

def run_architecture_experiment(arch_name, model_class, feature_dim=2, 
                                epochs=50, use_full_dataset=False):
    """Run experiment for a single architecture"""
    
    print(f"\n{'='*60}")
    print(f"Testing Architecture: {arch_name}")
    print(f"{'='*60}")
    
    # Data loading
    transform_train = transforms.Compose([
        transforms.RandomCrop(32, padding=4),
        transforms.RandomHorizontalFlip(),
        transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2),
        transforms.ToTensor(),
        transforms.Normalize((0.4914, 0.4822, 0.4465), (0.2023, 0.1994, 0.2010))
    ])
    
    transform_test = transforms.Compose([
        transforms.ToTensor(),
        transforms.Normalize((0.4914, 0.4822, 0.4465), (0.2023, 0.1994, 0.2010))
    ])
    
    full_train = torchvision.datasets.CIFAR10(
        root='./data', train=True, download=True, transform=transform_train
    )
    full_test = torchvision.datasets.CIFAR10(
        root='./data', train=False, download=True, transform=transform_test
    )
    
    if use_full_dataset:
        train_dataset = full_train
        test_dataset = full_test
    else:
        train_dataset = Subset(full_train, range(8000))
        test_dataset = Subset(full_test, range(2000))
    
    train_loader = DataLoader(train_dataset, batch_size=128, 
                              shuffle=True, num_workers=4, pin_memory=True)
    test_loader = DataLoader(test_dataset, batch_size=128, 
                             shuffle=False, num_workers=4, pin_memory=True)
    
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model = model_class(input_channels=3, feature_dim=feature_dim, num_classes=10).to(device)
    
    # Count parameters
    num_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
    
    optimizer = optim.Adam(model.parameters(), lr=0.001, weight_decay=5e-4)
    scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)
    criterion = nn.CrossEntropyLoss()
    
    # Training
    best_accuracy = 0
    final_metrics = {}
    
    for epoch in range(1, epochs + 1):
        train_loss, train_acc = train_epoch(model, train_loader, optimizer, criterion, device)
        scheduler.step()
        
        if epoch % 20 == 0 or epoch == epochs:
            test_acc, features, labels = evaluate(model, test_loader, device, compute_features=True)
            
            if epoch == epochs:
                prototypes, _ = compute_prototypes_from_features(features.to(device), labels.to(device), 10)
                purity, _ = compute_cell_purity(features, labels, prototypes.cpu())
                collision, _ = compute_collision_mass(features, labels, prototypes.cpu())
                
                print(f"  Epoch {epoch}: Acc={test_acc:.4f}, Purity={purity:.4f}, Collision={collision:.4f}")
                
                final_metrics = {
                    'architecture': arch_name,
                    'num_parameters': num_params,
                    'test_accuracy': test_acc,
                    'cell_purity': purity,
                    'collision_mass': collision,
                    'epochs_trained': epochs
                }
                
                if test_acc > best_accuracy:
                    best_accuracy = test_acc
    
    final_metrics['best_accuracy'] = best_accuracy
    
    print(f"\n  FINAL: {arch_name}")
    print(f"    Parameters: {num_params:,}")
    print(f"    Accuracy: {final_metrics['test_accuracy']:.4f}")
    print(f"    Purity: {final_metrics['cell_purity']:.4f}")
    print(f"    Collision: {final_metrics['collision_mass']:.4f}")
    
    return final_metrics


# ============================================================================
# 6. MAIN EXPERIMENT (STEP 9)
# ============================================================================

def run_step9_experiment(feature_dim=2, epochs=50, use_full_dataset=False):
    """
    Step 9: Architecture and Kernel Effects
    
    Compares:
    - ShallowCNN (low capacity)
    - StandardCNN (baseline from previous steps)
    - WideCNN (more channels)
    - DeepCNN (more layers with residuals)
    """
    
    save_dir = f'step9_results_architecture_m{feature_dim}'
    os.makedirs(save_dir, exist_ok=True)
    
    architectures = {
        'Shallow': ShallowCNN,
        'Standard': StandardCNN,
        'Wide': WideCNN,
        'Deep': DeepCNN
    }
    
    print("\n" + "="*70)
    print("Step 9: Architecture and Kernel Effects (NTK Preconditioning)")
    print("="*70)
    print(f"Feature dimension: {feature_dim}")
    print(f"Epochs per architecture: {epochs}")
    print("="*70 + "\n")
    
    all_results = []
    
    for arch_name, model_class in architectures.items():
        start_time = time.time()
        results = run_architecture_experiment(
            arch_name, model_class, feature_dim, epochs, use_full_dataset
        )
        results['time_minutes'] = (time.time() - start_time) / 60
        all_results.append(results)
        
        # Save intermediate
        with open(f'{save_dir}/results_{arch_name.lower()}.json', 'w') as f:
            json.dump(results, f, indent=2)
    
    # Aggregate results
    names = [r['architecture'] for r in all_results]
    params = [r['num_parameters'] for r in all_results]
    accuracies = [r['test_accuracy'] for r in all_results]
    purities = [r['cell_purity'] for r in all_results]
    collisions = [r['collision_mass'] for r in all_results]
    
    print("\n" + "="*70)
    print("Step 9 Results Summary")
    print("="*70)
    print(f"{'Architecture':<15} {'Parameters':<15} {'Accuracy':<12} {'Purity':<12} {'Collision':<12}")
    print("-" * 70)
    for i, name in enumerate(names):
        print(f"{name:<15} {params[i]:<15,} {accuracies[i]:<12.4f} {purities[i]:<12.4f} {collisions[i]:<12.4f}")
    print("-" * 70)
    
    # Find best architecture
    best_idx = np.argmax(accuracies)
    print(f"\nBest architecture: {names[best_idx]} (Accuracy: {accuracies[best_idx]:.4f})")
    
    # Generate plots
    plot_architecture_comparison(names, params, accuracies, purities, collisions, save_dir)
    plot_purity_vs_parameters(params, purities, accuracies, names, save_dir)
    
    # Save all results
    final_results = {
        'feature_dim': feature_dim,
        'epochs': epochs,
        'architectures': names,
        'num_parameters': params,
        'accuracies': accuracies,
        'purities': purities,
        'collisions': collisions,
        'best_architecture': names[best_idx],
        'per_arch_results': all_results
    }
    
    torch.save(final_results, f'{save_dir}/all_results.pt')
    
    with open(f'{save_dir}/summary.json', 'w') as f:
        json.dump({k: v for k, v in final_results.items() if k != 'per_arch_results'}, f, indent=2)
    
    print(f"\nResults saved to {save_dir}/")
    print("Step 9 Complete!")
    
    return final_results


