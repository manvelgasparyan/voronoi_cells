    axes[1, 1].bar(names, collisions, color='red', alpha=0.7)
    axes[1, 1].set_xlabel('Architecture')
    axes[1, 1].set_ylabel('Collision Mass')
    axes[1, 1].set_title('Collision Mass (lower is better)')
